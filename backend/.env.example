# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/student_mentoring_system

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional AI feature (Phase 10) - only needed if AI progress-summary is used.
# Uses Google's Gemini API (generativelanguage.googleapis.com).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
